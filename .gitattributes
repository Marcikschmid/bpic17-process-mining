* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.sty text eol=lf
*.cls text eol=lf
*.pdf binary
*.png binary
*.imscc binary

# Preserve the exact bytes recorded in discovery_manifest.json, including on Windows.
results/models/*.pnml -text whitespace=cr-at-eol
results/figures/*.gv -text whitespace=cr-at-eol
results/figures/*.svg -text whitespace=cr-at-eol
# Checksummed generated artifacts must retain identical bytes on every platform.
results/** -text whitespace=cr-at-eol
report/tables/** -text whitespace=cr-at-eol
report/sections/decision_appendix.tex -text whitespace=cr-at-eol
src/*.html text eol=lf
# Matplotlib emits intentional spaces in SVG path data; preserve checksums.
results/**/*.svg -text -whitespace

# Preserve the exact executed source bytes pinned by the historical Genetic audit.
scripts/recover_genetic_export.py -text whitespace=cr-at-eol
scripts/verify_genetic_trial.py -text whitespace=cr-at-eol
